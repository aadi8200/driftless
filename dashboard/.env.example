# DRIFTLESS ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and configure for your deployment

SECRET_KEY=driftless-dev-secret-key-change-in-production-please-random-hash
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.pythonanywhere.com,.onrender.com

# Optional database URL (defaults to SQLite if unset):
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:password@hostname:5432/driftless_db

# Production domain origins (comma-separated):
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CORS_ALLOW_ALL_ORIGINS=True

# Email configuration (Optional - leave empty for dev):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
