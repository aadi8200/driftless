# DRIFTLESS ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and configure for your deployment

SECRET_KEY=driftless-production-secret-key-change-this-hash
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.pythonanywhere.com,.onrender.com,.railway.app

# Cross-Origin & CSRF Configuration
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.onrender.com,https://*.pythonanywhere.com,https://*.railway.app
CORS_ALLOW_ALL_ORIGINS=True

# Gmail SMTP Email OTP Configuration
# Generate a 16-character Google App Password at: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_google_app_password
DEFAULT_FROM_EMAIL=Driftless <your_email@gmail.com>

# Google Identity / OAuth2 Client ID
# Optional for Google Sign-In; if unset, an interactive demo selector is provided automatically
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
